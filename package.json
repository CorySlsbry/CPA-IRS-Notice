{
  "name": "noticereply",
  "version": "0.1.0",
  "private": true,
  "description": "AI-drafted IRS notice responses + built-in CRM/analytics suite for CPA firms. Cloud Run + Cloud SQL + Firebase Auth.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "fallow": "fallow --summary",
    "db:proxy": "echo \"Run: cloud-sql-proxy <PROJECT>:<REGION>:noticereply --port 5432\"",
    "db:migrate": "echo \"Run: bash scripts/migrate-db.sh\"",
    "tick": "curl -X POST http://localhost:3000/api/workflows/tick -H \"x-cron-secret: $CRON_SECRET\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.0",
    "@google-cloud/storage": "^7.19.0",
    "@google/genai": "^1.52.0",
    "@hookform/resolvers": "^5.2.0",
    "@lob/lob-typescript-sdk": "^1.3.6",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.8",
    "@tanstack/react-query": "^5.100.0",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "firebase": "^12.13.0",
    "firebase-admin": "^13.8.0",
    "framer-motion": "^12.38.0",
    "googleapis": "^171.4.0",
    "lucide-react": "^1.14.0",
    "nanoid": "^5.1.0",
    "next": "^16.2.5",
    "next-themes": "^0.4.6",
    "papaparse": "^5.5.3",
    "pg": "^8.20.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-email": "^6.1.1",
    "react-hook-form": "^7.75.0",
    "react-syntax-highlighter": "^16.1.1",
    "reactflow": "^11.11.4",
    "recharts": "^3.8.1",
    "resend": "^6.12.0",
    "sonner": "^2.0.7",
    "stripe": "^22.1.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "ua-parser-js": "^2.0.9",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.0",
