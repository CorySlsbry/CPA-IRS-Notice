{
  "name": "noticereply",
  "version": "0.1.0",
  "private": true,
  "description": "AI-drafted IRS notice responses + built-in CRM/analytics suite for CPA firms.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "fallow": "fallow --summary",
    "db:types": "supabase gen types typescript --project-id $SUPABASE_PROJECT_ID --schema public > lib/supabase/database.types.ts",
    "tick": "curl -X POST http://localhost:3000/api/workflows/tick -H \"x-cron-secret: $CRON_SECRET\""
  },
