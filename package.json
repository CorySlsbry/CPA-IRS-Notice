    "autoprefixer": "^10.5.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "^16.2.5",
    "fallow": "^2.66.0",
    "fast-check": "^4.7.0",
    "happy-dom": "^20.9.0",
    "postcss": "^8.5.0",
    "prettier": "^3.8.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
