# NoticeReply environment variables.
# Copy to .env.local and fill in real values. NEVER commit .env.local.

# ─── Core ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=

# ─── Anthropic (Sonnet 4.6 + Vision OCR) ─────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_PRIMARY=claude-sonnet-4-6
ANTHROPIC_MODEL_FALLBACK=claude-opus-4-7
ANTHROPIC_MODEL_VISION=claude-sonnet-4-6

# ─── Google (Imagen 4 Ultra + Workspace OAuth for Gmail inbound) ─────────────
GOOGLE_GENAI_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/inbox/oauth/callback
# Encrypted in DB after first install; this fallback is for solo-tenant setups.
GOOGLE_OAUTH_REFRESH_TOKEN=
GMAIL_INBOX_USER=support@salisburybookkeeping.com
# Optional: Gmail Pub/Sub push topic for sub-second inbound delivery.
GMAIL_PUBSUB_TOPIC=

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FOUNDING=
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_PRO=

# ─── Lob (print-and-mail certified IRS letters) ───────────────────────────────
LOB_API_KEY=
# Use sk_test_* during development. Lob test mode never bills or mails.
LOB_FROM_NAME=NoticeReply on behalf of CPA Firm
LOB_FROM_LINE1=
LOB_FROM_CITY=
LOB_FROM_STATE=
LOB_FROM_ZIP=

# ─── Resend (outbound email) ──────────────────────────────────────────────────
RESEND_API_KEY=
# Marketing/bulk/cold sends use the subdomain to protect apex reputation.
RESEND_MARKETING_DOMAIN=mail.salisburybookkeeping.com
# Transactional sends use the apex.
RESEND_TRANSACTIONAL_DOMAIN=salisburybookkeeping.com
DEFAULT_FROM_EMAIL=support@salisburybookkeeping.com
DEFAULT_FROM_NAME=Cory @ Salisbury Bookkeeping
# Comma-separated list of test recipients allowed during dev. Empty = no restriction.
EMAIL_TEST_ALLOWLIST=

# ─── Cron / internal API auth ─────────────────────────────────────────────────
# Long random secret. Vercel Cron + Supabase pg_cron pass this in x-cron-secret.
CRON_SECRET=
# Used by /api/track/identify when called from server-side firm code.
TRACK_INTERNAL_SECRET=

# ─── Tracking pixel host (override for white-label firms) ─────────────────────
TRACKING_HOST=http://localhost:3000

# ─── Optional: Sentry / observability ─────────────────────────────────────────
SENTRY_DSN=
