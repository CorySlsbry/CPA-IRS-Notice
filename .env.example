# NoticeReply environment variables.
# Copy to .env.local and fill in real values. NEVER commit .env.local.

# ─── Core ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Cloud SQL Postgres ───────────────────────────────────────────────────────
# Local dev: run `cloud-sql-proxy <INSTANCE> --port 5432` then point at it.
# Cloud Run: use a Unix-socket connection string and attach the instance via
#   --add-cloudsql-instances <PROJECT>:<REGION>:<INSTANCE> on deploy.
# Local example:   postgres://app:<pwd>@127.0.0.1:5432/noticereply
# Cloud Run example: postgres://app:<pwd>@/noticereply?host=/cloudsql/<INSTANCE>
DATABASE_URL=
DATABASE_MAX_CONNECTIONS=5

# ─── Firebase Auth ────────────────────────────────────────────────────────────
# Public — inlined into the bundle at build time.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Server — full service-account JSON. On Cloud Run with a service account
# attached, you can leave this blank and rely on Application Default Creds.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=

# ─── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_PRIMARY=claude-sonnet-4-6
ANTHROPIC_MODEL_FALLBACK=claude-opus-4-7
ANTHROPIC_MODEL_VISION=claude-sonnet-4-6

# ─── Google Cloud ─────────────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=
GCS_BUCKET_UPLOADS=noticereply-uploads

# ─── Google (Imagen + Workspace OAuth for Gmail inbound) ─────────────────────
GOOGLE_GENAI_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/inbox/oauth/callback
GOOGLE_OAUTH_REFRESH_TOKEN=
GMAIL_INBOX_USER=support@salisburybookkeeping.com
GMAIL_PUBSUB_TOPIC=

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FOUNDING=
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_PRO=

# ─── Lob ──────────────────────────────────────────────────────────────────────
LOB_API_KEY=
LOB_FROM_NAME=NoticeReply on behalf of CPA Firm
LOB_FROM_LINE1=
LOB_FROM_CITY=
LOB_FROM_STATE=
LOB_FROM_ZIP=

# ─── Resend ───────────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_MARKETING_DOMAIN=mail.salisburybookkeeping.com
RESEND_TRANSACTIONAL_DOMAIN=salisburybookkeeping.com
DEFAULT_FROM_EMAIL=support@salisburybookkeeping.com
DEFAULT_FROM_NAME=Cory @ Salisbury Bookkeeping
EMAIL_TEST_ALLOWLIST=

# ─── Social posting + reply automation ───────────────────────────────────────
# Used by lib/social/* (Facebook + Instagram via Meta Graph API).
# Generate token key once: openssl rand -base64 64 | tr -d '\n'
SOCIAL_TOKEN_KEY=
META_WEBHOOK_VERIFY_TOKEN=
# App secret used to validate X-Hub-Signature-256 on webhook POSTs.
META_APP_SECRET=

# ─── Lead-magnet import target ───────────────────────────────────────────────
# UUID of the firm that should receive imported lead-magnet signups.
# Once you sign up your own NoticeReply firm, set this to that firm's id.
MARKETING_FIRM_ID=

# ─── Cron / internal API auth ─────────────────────────────────────────────────
# Cloud Scheduler hits Cloud Run with the x-cron-secret header set to this.
CRON_SECRET=
TRACK_INTERNAL_SECRET=

# ─── Tracking pixel host ──────────────────────────────────────────────────────
TRACKING_HOST=http://localhost:3000

# ─── Optional: Sentry / observability ─────────────────────────────────────────
SENTRY_DSN=
